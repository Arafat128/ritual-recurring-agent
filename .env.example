# SQLite (path relative to packages/core/prisma/schema.prisma)
DATABASE_URL="file:../../../data/ritual-agent.db"

# ── Multi-tenant operator ──────────────────────────────────────────
# Shared burner that EXECUTES rules for all users (fund with faucet RITUAL)
AGENT_PRIVATE_KEY=0x...

# Where users send RITUAL top-ups (defaults to agent.evm if unset)
FEE_RECIPIENT=0x...

# Optional: wallets that may edit global limits (Settings)
# OWNER_ADDRESSES=0xYourAdminWallet

# Session HMAC (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Optional fee overrides (ETH units of RITUAL, or wei as integer)
# FEE_CREATE_BASE_ETH=0.001
# FEE_CREATE_RECURRING_ETH=0.002
# FEE_RUN_PING_ETH=0.0002
# FEE_RUN_SEND_ETH=0.0005

# Chains
NEXT_PUBLIC_RITUAL_RPC=https://rpc.ritualfoundation.org
NEXT_PUBLIC_RITUAL_CHAIN_ID=1979
RPC_URL_RITUAL=https://rpc.ritualfoundation.org
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_BASE=https://base-rpc.publicnode.com
NEXT_PUBLIC_RPC_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com

# Dashboard public
NEXT_PUBLIC_APP_NAME=Ritual Recurring Agent
NEXT_PUBLIC_EXPLORER_RITUAL=https://explorer.ritualfoundation.org
NEXT_PUBLIC_EXPLORER_BASE=https://basescan.org
NEXT_PUBLIC_FEE_RECIPIENT=

# App limits (operator caps on burner spend)
MAX_TX_USD=25
MAX_TX_PER_DAY=20

# Optional Telegram notify (not for signing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LI.FI for Base mainnet swaps (https://li.fi)
LIFI_API_KEY=

# Vercel cron (Bearer for /api/cron/worker)
CRON_SECRET=

# Live execution: fund AGENT_PRIVATE_KEY on Ritual before send rules
